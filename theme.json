{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1440px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "cream", "name": "Cream", "color": "#FBF7F0" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#14201A" },
				{ "slug": "forest", "name": "Forest", "color": "#1F3D2B" },
				{ "slug": "forest-soft", "name": "Forest soft", "color": "#E6EDE4" },
				{ "slug": "coral", "name": "Coral", "color": "#E4703F" },
				{ "slug": "sand", "name": "Sand", "color": "#EFE3D2" },
				{ "slug": "muted", "name": "Muted", "color": "#5C6B60" },
				{ "slug": "line", "name": "Line", "color": "#E3DCCF" },
				{ "slug": "ink-deep", "name": "Footer ink", "color": "#141F19" }
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "13px" },
				{ "slug": "medium", "name": "Medium", "size": "16px" },
				{ "slug": "large", "name": "Large", "size": "20px" },
				{ "slug": "x-large", "name": "Extra large", "size": "28px" },
				{ "slug": "xx-large", "name": "Display", "size": "44px" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1 — 8px", "size": "8px" },
				{ "slug": "20", "name": "2 — 16px", "size": "16px" },
				{ "slug": "30", "name": "3 — 24px", "size": "24px" },
				{ "slug": "40", "name": "4 — 40px", "size": "40px" },
				{ "slug": "50", "name": "5 — 64px", "size": "64px" },
				{ "slug": "60", "name": "6 — 96px", "size": "96px" }
			]
		},
		"custom": {
			"radius": {
				"card": "20px",
				"media": "24px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|cream",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "16px",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|ink" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"lineHeight": "1.12",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "56px" } },
			"h2": { "typography": { "fontSize": "40px" } },
			"h3": { "typography": { "fontSize": "20px" } },
			"link": {
				"color": { "text": "var:preset|color|forest" },
				"typography": { "textDecoration": "none" }
			},
			"button": {
				"border": { "radius": "999px", "width": "0", "style": "solid" },
				"color": {
					"background": "var:preset|color|forest",
					"text": "#FFFFFF"
				},
				"spacing": {
					"padding": { "top": "16px", "bottom": "16px", "left": "28px", "right": "28px" }
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "16px",
					"fontWeight": "600"
				},
				":hover": {
					"color": { "background": "#162E20", "text": "#FFFFFF" }
				}
			}
		},
		"blocks": {
			"core/group": {
				"spacing": { "padding": { "top": "0", "bottom": "0" } }
			}
		}
	}
}
